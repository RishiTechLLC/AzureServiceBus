{
  "ServiceBus": {
    "ConnectionString": "",
    "FullyQualifiedNamespace": "",
    "UseWebSockets": false,
    "QueueName": "orders",
    "SessionQueueName": "orders-sessions",
    "TopicName": "order-events",
    "SubscriptionName": "all-orders",
    "Retry": {
      "MaxRetries": 5,
      "Delay": "00:00:00.800",
      "MaxDelay": "00:00:30",
      "TryTimeout": "00:01:00"
    },
    "Processing": {
      "MaxConcurrentCalls": 4,
      "PrefetchCount": 10,
      "MaxConcurrentSessions": 4,
      "MaxAutoLockRenewalDuration": "00:05:00",
      "SessionIdleTimeout": "00:00:10",
      "SimulatedWorkDuration": "00:00:00.250"
    },
    "DeadLetter": {
      "MaxResubmitAttempts": 3,
      "BatchSize": 50,
      "RetryableReasons": [
        "MaxDeliveryCountExceeded",
        "TTLExpiredException",
        "TransientFailure"
      ],
      "ArchiveFolder": "dlq-archive"
    }
  }
}
